# Copy to .env and edit as needed. Anything you don't set here falls
# back to the default in app/config.py.

HOST=0.0.0.0
PORT=8000

# External binary. ffprobe.exe is assumed to sit next to ffmpeg.exe in
# the same directory — change here if you move the install.
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Chunked upload size in bytes (default 2 MiB).
UPLOAD_CHUNK_SIZE=2097152

# Sprite sheet layout.
SPRITE_THUMB_WIDTH=160
SPRITE_THUMB_HEIGHT=90
SPRITE_INTERVAL_MS=1000
SPRITE_COLS=10

# Zone-mode smoothing.
#   SMOOTHING_WINDOW    Savitzky-Golay window (must be odd)
#   SMOOTHING_POLYORDER SG polynomial order (must be < window)
#   PEAK_PROMINENCE     Min peak prominence, position units (0-100)
#   PEAK_MIN_DISTANCE_MS Min ms between emitted actions (~12 Hz cap)
SMOOTHING_WINDOW=11
SMOOTHING_POLYORDER=3
PEAK_PROMINENCE=4.0
PEAK_MIN_DISTANCE_MS=80

# Zone-mode rolling auto-range.
#   ZONE_ROLLING_WINDOW_MS  Width of the local min/max window used to
#                           map motion → 0..100. Wide enough to span
#                           several strokes; too narrow chases peaks.
#   ZONE_MIN_AMPLITUDE_PX   Floor on local range in accumulated pixels.
#                           Prevents LK noise in a still section from
#                           being amplified to full-swing strokes.
ZONE_ROLLING_WINDOW_MS=3000
ZONE_MIN_AMPLITUDE_PX=5.0

# Marker-mode (point-color) beat detection.
#   MARKER_PROMINENCE          Min color-deviation prominence, 0-100.
#                              Higher = only dramatic color changes fire.
#   MARKER_MIN_DISTANCE_MS     Min ms between beats (5 Hz cap by default).
#   MARKER_BASELINE_WINDOW_MS  Rolling median window for the "normal"
#                              color at the hit point.
MARKER_PROMINENCE=15.0
MARKER_MIN_DISTANCE_MS=100
MARKER_BASELINE_WINDOW_MS=2000

# Motion smoothing — smoothstep interpolation points inserted between
# each beat and its next peak. 0 = raw triangle wave (jerky), 2-3 =
# S-curve motion around each reversal.
MARKER_MOTION_SMOOTHING=2

# Marker stroke shaping — interval thresholds for the depth scale.
#   MARKER_FAST_INTERVAL_MS   <= this = fully fast (uses max_down_fast)
#   MARKER_SLOW_INTERVAL_MS   >= this = fully slow (uses max_down)
MARKER_FAST_INTERVAL_MS=250
MARKER_SLOW_INTERVAL_MS=1000

# Beat signal weights.
#   MARKER_CONTRAST_WEIGHT   Spatial contrast (inner vs outer annulus).
#                            Primary signal; cancels animated backgrounds.
#   MARKER_DELTA_WEIGHT      Temporal delta (frame-to-frame). Fallback
#                            for same-color-as-background markers on
#                            solid backgrounds.
MARKER_CONTRAST_WEIGHT=1.0
MARKER_DELTA_WEIGHT=0.5
# HSV signal components — hue and saturation distances between the
# inner and outer regions. More discriminative than BGR alone for
# markers with distinct colors overlaid on animated backgrounds.
MARKER_HUE_WEIGHT=0.5
MARKER_SAT_WEIGHT=0.5
# Template matching weight (only used when a job includes a template).
MARKER_TEMPLATE_WEIGHT=1.5

# Outer annulus geometry, as multiples of the marker radius. The ring
# from r*START to r*END is compared against the inner circle to compute
# contrast. Move START closer to 1.0 for tight overlays; push END up if
# the marker itself is larger than the user's inner circle.
MARKER_OUTER_START_FACTOR=1.5
MARKER_OUTER_END_FACTOR=2.5

# Section detection: consecutive beats whose interval differs by less
# than TEMPO_TOLERANCE (as fraction of the running interval) are treated
# as one section that shares a single amplitude — makes rhythmic
# passages have consistent stroke heights.
MARKER_SECTION_TEMPO_TOLERANCE=0.2

# Cross-section variety (per-job default). 0 = identical tempo target
# every section, 1 = full sub-range randomization inside each section's
# tempo envelope. Determined by a seed from the beat pattern so re-runs
# produce the same script.
MARKER_VARIETY_AMOUNT=0.0

# Idle animation for silent gaps (before first beat, between sections,
# after last beat). Slow oscillation instead of leaving the toy static.
# Gaps shorter than IDLE_GAP_THRESHOLD_MS are left alone.
MARKER_IDLE_ENABLED=true
MARKER_IDLE_GAP_THRESHOLD_MS=2000
MARKER_IDLE_PERIOD_MS=3000
MARKER_IDLE_MIN_POS=30
MARKER_IDLE_MAX_POS=70
